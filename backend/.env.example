# Firebase — one of these two is required for auth
FIREBASE_CREDENTIALS_PATH=./firebase-key.json  # path to JSON file (local dev)

# LLM providers — at least one required for coaching suggestions
GROQ_API_KEY=

# CORS — comma-separated origins allowed to call this API
APP_CORS_ORIGINS=http://localhost:5173,https://docs.google.com

# Jina AI — required for embeddings
JINA_API_KEY=

# Pinecone — required for vector search
PINECONE_API_KEY=
PINECONE_INDEX_NAME=writing-coach

# Dev only — set APP_AUTH_BYPASS=1 to skip Firebase token verification locally
APP_AUTH_BYPASS=0
APP_DEBUG_USER=dev-user-id
