# Firebase (same credentials as the old app-api)
FIREBASE_CREDENTIALS=          # inline JSON string (preferred for deployment)
FIREBASE_CREDENTIALS_PATH=./firebase-key.json  # path to JSON file (local dev)

# Internal secret shared with Node mechanics service
COACHING_INTERNAL_SECRET=changeme

# Node mechanics service URL
MECHANICS_API_URL=http://127.0.0.1:8787

# LLM providers (at least one required for coaching)
GROQ_API_KEY=
OPENAI_API_KEY=

# CORS — comma-separated origins allowed to call this API
APP_CORS_ORIGINS=http://localhost:5173,https://docs.google.com

# Chroma persistent storage path
CHROMA_PERSIST_PATH=./chroma_db

# Dev only — bypasses Firebase token verification
APP_AUTH_BYPASS=0
APP_DEBUG_USER=dev-user-id

PORT=8000
